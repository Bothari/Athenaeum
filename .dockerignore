# Docker does not honour .gitignore, so data/ — which holds real API keys and the
# SQLite database — would otherwise be baked into the image by `COPY . .`.
data/

.git/
.venv/
venv/
__pycache__/
*.pyc

# Regenerated by the frontend build stage; copying the host's would be both slow
# and a source of stale output.
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
