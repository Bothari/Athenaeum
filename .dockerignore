# Docker does not honour .gitignore, and the published image is PUBLIC
# (ghcr.io/bothari/athenaeum, anonymous pull works). Anything `COPY . .` picks up
# ships to the world on the next tag, so this list fails closed: it covers secrets
# that are not present today but would be caught silently if someone created them.
data/
*.db
.env
.beads/
CLAUDE.local.md
.scratch/

.git/
.venv/
venv/
__pycache__/
*.pyc

# Regenerated by the frontend build stage; copying the host's would be both slow
# and a source of stale output.
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
